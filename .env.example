# Copy to .env and set credentials before running PostgreSQL Compose services.
# Do not commit .env, migration archives or database/media backups.

FRONTEND_PORT=4200
BACKEND_PORT=8000
POSTGRES_EXPOSED_PORT=5433
# Legacy MySQL source port (leave source credentials unchanged during transfer).
DB_EXPOSED_PORT=3307

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8000
GROQ_API_KEY=

CURRENCY_CODE=KGS
CURRENCY_SYMBOL=сом
CURRENCY_LOCALE=ky-KG

# Never bootstrap or seed an import target before transferring existing data.
BOOTSTRAP_ADMIN=false
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_PIN=
SEED_DATA=false

# PostgreSQL primary database. Set all credentials explicitly.
DB_ENGINE=django.db.backends.postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=brandx
DB_USER=brandx
DB_PASSWORD=
# Existing MySQL root password, only needed for legacy-mysql profile.
DB_ROOT_PASSWORD=
