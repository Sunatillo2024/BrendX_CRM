# Copy to .env to override the docker-compose defaults.
# All values below are the defaults baked into docker-compose.yml.

# --- Host ports ---
FRONTEND_PORT=4200
BACKEND_PORT=8000
DB_EXPOSED_PORT=3307

# --- Django ---
SECRET_KEY=django-insecure-brandx-docker-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8000
GROQ_API_KEY=

# --- Currency (Kyrgyz som by default) ---
CURRENCY_CODE=KGS
CURRENCY_SYMBOL=сом
CURRENCY_LOCALE=ky-KG

# --- Default admin created on startup ---
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=1
DJANGO_ADMIN_PIN=0808
SEED_DATA=true

# --- MySQL ---
DB_NAME=brandx
DB_USER=brandx
DB_PASSWORD=brandx
DB_ROOT_PASSWORD=brandx_root
