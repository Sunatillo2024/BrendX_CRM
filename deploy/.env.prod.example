# ===========================================================================
# BrandX - production environment.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   # then edit deploy/.env.prod and fill in every empty value
#
# This file (deploy/.env.prod) is git-ignored and must NEVER be committed.
# ===========================================================================

# ---------------------------------------------------------------------------
# Public exposure
# ---------------------------------------------------------------------------
# Host interface the web container is published on:
#   127.0.0.1 -> reachable only from the server itself (RECOMMENDED: put a host
#                Nginx/Caddy in front, see deploy/proxy/brandx.conf).
#   0.0.0.0   -> directly reachable on the LAN/internet (no TLS!).
BRANDX_HTTP_BIND=127.0.0.1

# Host port for the web container. Pick a FREE port - run:
#   ./deploy/scripts/preflight.sh
BRANDX_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

DEBUG=False

# Comma-separated. Include every hostname/IP the site is reached by.
ALLOWED_HOSTS=pos.example.com,localhost,127.0.0.1

# Frontend origin(s) allowed to call the API (scheme + host, no trailing slash).
CORS_ALLOWED_ORIGINS=https://pos.example.com

# Trusted origins for the Django admin over HTTPS (must include the scheme).
CSRF_TRUSTED_ORIGINS=https://pos.example.com

BUSINESS_NAME=BrandX
CURRENCY_CODE=KGS
CURRENCY_SYMBOL=сом
CURRENCY_LOCALE=ky-KG
DEFAULT_LANGUAGE=uz

GROQ_API_KEY=

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# ---------------------------------------------------------------------------
# PostgreSQL (matches the `postgres` service in docker-compose.prod.yml)
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=brandx
DB_USER=brandx
DB_PASSWORD=

# ---------------------------------------------------------------------------
# HTTPS hardening - enable ONLY once the site is served over HTTPS.
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# 31536000 = 1 year. Start with 0 and raise after HTTPS is verified.
SECURE_HSTS_SECONDS=0

# ---------------------------------------------------------------------------
# First-boot provisioning - keep these false after the first successful deploy
# so restarts never reset credentials.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN=false
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_PIN=
SEED_DATA=false
SEED_STORE_CODE=
